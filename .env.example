# Godabaya Tailor — Konfigurasi Aplikasi (Expo)
#
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# Variabel harus berawalan EXPO_PUBLIC_ agar terbaca di aplikasi.

# Alamat backend API.
# - Uji lokal: kosongkan (otomatis pakai IP dev-server + port 3001).
# - Produksi : isi domain server publik (WAJIB https untuk website).
# EXPO_PUBLIC_API_URL=https://godabaya-api.up.railway.app

# Aktifkan halaman admin di WEB. Default: admin hanya tersedia di APK/native.
# Website customer bersifat publik sehingga admin disembunyikan di web.
# Set 'true' hanya bila kamu memang membuat build web khusus admin.
# EXPO_PUBLIC_ENABLE_ADMIN=false
