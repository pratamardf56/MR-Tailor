# Godabaya Tailor — Konfigurasi Backend (server/)
#
# Salin file ini menjadi `.env` di folder server/ (atau set sebagai
# environment variables di platform hosting seperti Railway/Render).

# Port server (Railway/Render biasanya mengisi otomatis).
# PORT=3001

# Folder penyimpanan database SQLite (WAJIB persisten di produksi).
# Di Railway/Render, arahkan ke path volume persisten.
# DATA_DIR=/data

# Origin yang diizinkan mengakses API (dipisah koma).
# Kosong = izinkan semua (HANYA untuk pengembangan).
# Produksi: isi domain website customer.
# ALLOWED_ORIGINS=https://godabaya-tailor.vercel.app

# Kredensial admin penjahit. GANTI PIN sebelum go-public!
# ADMIN_USERNAME=081214386602
# ADMIN_PIN=ganti-pin-kuat
# ADMIN_NAME=Penjahit

# Rate limit login (anti brute-force).
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MS=900000
